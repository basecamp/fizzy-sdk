{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Conformance Test",
  "description": "Schema for Fizzy SDK conformance test files",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["name", "operation", "assertions"],
    "properties": {
      "name": { "type": "string", "description": "Human-readable test name" },
      "description": { "type": "string" },
      "operation": { "type": "string", "description": "Operation ID from the Smithy spec" },
      "method": { "type": "string", "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD"] },
      "path": { "type": "string", "description": "URI template for the operation" },
      "pathParams": { "type": "object", "additionalProperties": true },
      "queryParams": { "type": "object", "additionalProperties": true },
      "requestBody": { "type": "object" },
      "configOverrides": {
        "type": "object",
        "properties": {
          "baseUrl": { "type": "string" },
          "maxPages": { "type": "integer" },
          "maxItems": { "type": "integer" },
          "maxRetries": {
            "type": "integer",
            "minimum": 0,
            "description": "Override the client-wide retry cap as a TOTAL attempt count. 0 means no retries — exactly one attempt — and is the value this key exists for. Go, Ruby, Kotlin and Rust take it as their numeric cap. TypeScript and Swift expose no numeric cap, only enableRetry, so a cap of 0 OR 1 maps to enableRetry: false and anything above to enableRetry: true; a cap above 1 pins an exact attempt count only in the numeric SDKs. Negative values are rejected here rather than left to the constructors."
          }
        }
      },
      "mockResponses": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "status": { "type": "integer" },
            "headers": { "type": "object", "additionalProperties": { "type": "string" } },
            "body": {},
            "delay": { "type": "integer", "description": "Delay in milliseconds before responding" }
          }
        }
      },
      "assertions": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "requestCount", "delayBetweenRequests", "statusCode",
                "noError", "errorCode", "errorField",
                "headerPresent", "headerValue",
                "requestPath", "urlOrigin",
                "responseMeta",
                "responseBody", "errorMessage", "headerInjected",
                "requestScheme", "requestBodyField", "requestQueryParam"
              ]
            },
            "expected": {},
            "path": { "type": "string" },
            "min": { "type": "integer" }
          }
        }
      },
      "tags": {
        "type": "array",
        "items": { "type": "string" }
      }
    }
  }
}
